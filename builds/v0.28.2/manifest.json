{
  "manifest_version": 3,
  "name": "SalesTeam - AI Sales Team for LinkedIn",
  "version": "0.28.2",
  "description": "Scan LinkedIn for leads, get AI prioritization and outreach advice, and pressure-test your messages with an AI Customer Voice.",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.anthropic.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SalesTeam",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/content/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs/search-results/*"],
      "js": ["jobs-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
