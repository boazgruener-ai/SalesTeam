{
  "manifest_version": 3,
  "name": "SalesTeam - AI Sales Team for LinkedIn",
  "version": "1.1.6",
  "description": "Searches LinkedIn for relevant companies, contacts and posts, auto-filters noise, gets AI-prioritized results and drafts outreach.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "clipboardWrite", "power"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.anthropic.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SalesTeam",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/content/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs/search-results/*"],
      "js": ["jobs-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["profile-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/search/results/companies/*"],
      "js": ["company-resolve-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/company/*"],
      "js": ["company-resolve-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/search/results/companies/*"],
      "js": ["company-discovery-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/company/*"],
      "js": ["company-discovery-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/company/*/people/*"],
      "js": ["contact-discovery-content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/company/*"],
      "js": ["company-size-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
